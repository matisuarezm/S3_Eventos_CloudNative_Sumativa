              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": {{eventoId}},\n  \"cantidad\": 3,\n  \"nombreCliente\": \"Camila Rojas\",\n  \"emailCliente\": \"camila.rojas@correo.cl\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.collectionVariables.set('compraId', c.idCompra);",
                  "pm.test('Total = precio unitario x cantidad', () => pm.expect(c.precioTotal).to.eql(c.precioUnitario * c.cantidadEntradas));"
                ]
              }
            }
          ]

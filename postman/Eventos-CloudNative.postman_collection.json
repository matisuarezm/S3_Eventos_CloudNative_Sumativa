    {
      "name": "Tickets - Semana 3 (EFS + S3)",
      "item": [
        {
          "name": "1. Generar tickets (EFS -> S3 automatico)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ventasUrl}}/api/compras/{{compraId}}/tickets",
              "host": [
                "{{ventasUrl}}"
              ],
              "path": [
                "api",
                "compras",
                "{{compraId}}",
                "tickets"
              ]
            },
            "description": "Genera 1 PDF por entrada en EFS y los sube a S3 en tickets/evento-{id}/{usuario}/ticket-{n}.pdf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json(); pm.collectionVariables.set('ticketId', t[0].id);",
                  "pm.collectionVariables.set('eventoId', t[0].eventoId); pm.collectionVariables.set('usuario', t[0].usuario);",
                  "pm.test('Ruta por evento y usuario', () => pm.expect(t[0].rutaArchivo).to.match(/^tickets\\/evento-\\d+\\/.+\\/ticket-\\d+\\.pdf$/));"
                ]
              }
            }
          ]
        },

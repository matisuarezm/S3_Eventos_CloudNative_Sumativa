            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ventasUrl}}/api/compras",
              "host": [
                "{{ventasUrl}}"
              ],
              "path": [
                "api",
                "compras"
              ]
            },
            "description": "Para ver el 409, crea antes un evento con capacidad 5 y usa su id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": {{eventoId}},\n  \"cantidad\": 10,\n  \"nombreCliente\": \"Prueba Sin Cupos\",\n  \"emailCliente\": \"prueba@correo.cl\"\n}",
              "options": {

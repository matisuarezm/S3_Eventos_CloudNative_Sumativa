    {
      "name": "Resumen de compra - Semana 2 (ventas-service :8082 + S3)",
      "item": [
        {
          "name": "1. Generar resumen PDF (descarga directa)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ventasUrl}}/api/compras/{{compraId}}/resumen",
              "host": [
                "{{ventasUrl}}"
              ],
              "path": [
                "api",
                "compras",
                "{{compraId}}",
                "resumen"
              ]
            },
            "description": "Genera el PDF del resumen. En Postman: Send and Download / Save response to file."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es un PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Subir resumen a S3",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ventasUrl}}/api/compras/{{compraId}}/resumen/s3",
              "host": [
                "{{ventasUrl}}"
              ],
              "path": [
                "api",
                "compras",
                "{{compraId}}",
                "resumen",
                "s3"
              ]
            },
            "description": "Genera el PDF y lo sube a s3://bucket/resumenes/{id}/resumen-compra-{id}.pdf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Carpeta = numero de compra', () => pm.expect(pm.response.json().key).to.include('resumenes/' + pm.collectionVariables.get('compraId') + '/'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Descargar resumen desde S3",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ventasUrl}}/api/compras/{{compraId}}/resumen/s3",
              "host": [
                "{{ventasUrl}}"
              ],
              "path": [
                "api",
                "compras",
                "{{compraId}}",
                "resumen",
                "s3"
              ]
            },
            "description": "Descarga el PDF guardado en S3 (Send and Download)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "4a. Corregir datos del cliente",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{ventasUrl}}/api/compras/{{compraId}}",
              "host": [
                "{{ventasUrl}}"
              ],
              "path": [
                "api",
                "compras",
                "{{compraId}}"
              ]
            },
            "description": "Corrige nombre/email del cliente en la BD.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCliente\": \"Camila Rojas Perez\",\n  \"emailCliente\": \"camila.rojas@correo.cl\"\n}",
              "options": {
                "raw": {
                  "language": "json"
